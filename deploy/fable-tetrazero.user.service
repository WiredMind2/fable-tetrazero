[Unit]
Description=tetrazero.com static site + contact API (user)
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/fable-tetrazero
ExecStart=/usr/bin/python3 /var/www/fable-tetrazero/server/contact.py
Restart=on-failure
RestartSec=3
# Sandbox subset a user manager can enforce without privileges. The full set
# (ProtectSystem=strict, ProtectHome, ProtectKernel*, RestrictSUIDSGID,
# RestrictAddressFamilies) requires the system unit — see
# deploy/fable-tetrazero.service, installable with sudo via deploy.ps1.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
