---
import Base from '../layouts/Base.astro';
---

<Base title="404 - Tetrazero">
	<main class="flex min-h-screen flex-col items-center justify-center gap-6 px-6 text-center">
		<p class="font-mono text-xs tracking-[0.2em] text-muted uppercase">Error 404</p>
		<h1 class="font-display text-4xl font-semibold tracking-[-0.02em] md:text-5xl">
			Nothing at this address.
		</h1>
		<p class="max-w-md leading-relaxed text-muted">
			The page you are looking for was moved, renamed, or never existed.
		</p>
		<a
			href="/"
			class="btn-solid mt-2 inline-flex cursor-pointer items-center"
			>Back to tetrazero.com</a
		>
	</main>
</Base>
