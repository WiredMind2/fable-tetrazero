---
import '../styles/global.css';
import { siteConfig } from '../config/site';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Tetrazero - William Michaud',
	description = 'Portfolio of William Michaud, CS engineering student at INSA Lyon (class of 2027) on exchange at Lehigh University, CTO at Buddimm, seeking a 6-month internship from January 2027. Competitive programmer (2nd in France, ICPC European Championship).',
} = Astro.props;

const site = Astro.site ?? new URL('https://tetrazero.com');
const canonicalUrl = new URL(Astro.url.pathname, site).href;
const ogImageUrl = new URL(`/og-image.png?v=${siteConfig.ogImageVersion}`, site).href;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="color-scheme" content="light dark" />
		<script is:inline>
			try {
				const theme = localStorage.getItem('color-scheme');
				if (theme === 'light' || theme === 'dark') {
					document.querySelector('meta[name="color-scheme"]').content = theme;
				}
			} catch {}
		</script>
		<meta name="theme-color" content="#f4f5f7" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/og-image.png" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta
			name="keywords"
			content="William Michaud, Computer Science, Competitive Programming, Algorithms, Machine Learning, Python, C++, Web Development, Full-stack development, Internship, Software Engineering, Application Security, AI Automation"
		/>
		<meta name="author" content="William Michaud" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="512" />
		<meta property="og:image:height" content="512" />
		<meta property="og:image:alt" content="Tetrazero" />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:site_name" content={siteConfig.name} />
		{siteConfig.fbAppId && <meta property="fb:app_id" content={siteConfig.fbAppId} />}
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<link rel="canonical" href={canonicalUrl} />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="antialiased">
		<a class="skip-link" href="#main-content">Skip to content</a>
		<slot />
	</body>
</html>
