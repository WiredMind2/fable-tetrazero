---
import Base from './Base.astro';
import Footer from '../components/Footer.astro';
import ThemeSwitch from '../components/ThemeSwitch.astro';

interface Props {
	title: string;
	heading: string;
	effectiveDate: string;
}

const { title, heading, effectiveDate } = Astro.props;
---

<Base title={title}>
	<header class="border-b border-line bg-paper">
		<div class="mx-auto flex h-[4.5rem] w-full max-w-[90rem] items-center justify-between px-6 md:px-10 xl:px-16">
			<a href="/" class="text-sm font-semibold tracking-[-0.02em] text-ink no-underline">
				William <span class="text-blue">Michaud</span>
			</a>
			<div class="flex items-center gap-2 sm:gap-4">
				<ThemeSwitch />
				<a
					href="/"
					class="text-link text-sm text-muted hover:text-ink"
				>
					<span class="link-mark" aria-hidden="true">←</span>
					<span class="hidden sm:inline">Back to portfolio</span>
					<span class="sm:hidden">Portfolio</span>
				</a>
			</div>
		</div>
	</header>

	<main id="main-content" tabindex="-1" class="min-h-[70dvh] bg-canvas">
		<div class="mx-auto grid w-full max-w-[90rem] gap-12 px-6 py-16 md:px-10 md:py-24 lg:grid-cols-12 lg:gap-14 xl:px-16">
			<header class="lg:col-span-4">
				<p class="context-label">Tetrazero legal</p>
				<h1 class="mt-4 text-[clamp(2.75rem,6vw,5.5rem)] leading-[0.96] font-semibold tracking-[-0.055em]">
					{heading}
				</h1>
				<p class="mt-5 text-sm text-muted">Effective {effectiveDate}</p>
			</header>

			<div class="legal-body lg:col-span-7 lg:col-start-6">
				<slot />
			</div>
		</div>
	</main>
	<Footer />
</Base>

<style is:global>
	.legal-body h2 {
		margin-top: 3rem;
		margin-bottom: 1rem;
		color: var(--color-ink);
		font-size: clamp(1.25rem, 2vw, 1.55rem);
		font-weight: 600;
		letter-spacing: -0.025em;
		line-height: 1.2;
	}
	.legal-body h2:first-child {
		margin-top: 0;
	}
	.legal-body p {
		color: var(--color-muted);
		line-height: 1.75;
		margin-bottom: 1rem;
	}
	.legal-body ul {
		color: var(--color-muted);
		line-height: 1.7;
		margin: 1rem 0;
		padding: 0;
		list-style: none;
	}
	.legal-body li {
		position: relative;
		padding-left: 1.4rem;
		margin-bottom: 0.65rem;
	}
	.legal-body li::before {
		content: "";
		position: absolute;
		top: 0.72em;
		left: 0.15rem;
		width: 0.35rem;
		height: 0.35rem;
		border-radius: 50%;
		background: var(--color-orange);
	}
</style>
