---
import Container from './Container.astro';
---

<section class="border-b border-blue-surface bg-blue-surface py-12 text-white md:py-16">
	<Container>
		<div class="flex flex-col gap-7 md:flex-row md:items-center md:justify-between">
			<div>
				<p class="text-sm font-semibold text-white/70">One-page version</p>
				<h2 class="mt-2 text-2xl font-semibold tracking-[-0.035em] md:text-3xl">
					Prefer the condensed record?
				</h2>
				<p class="mt-2 max-w-xl text-white/70">Experience, skills, and contact details in one PDF.</p>
			</div>
			<a href="/Resume.pdf" download rel="noopener noreferrer" class="button button-light shrink-0">
				Download résumé <span aria-hidden="true">↓</span>
			</a>
		</div>
	</Container>
</section>
