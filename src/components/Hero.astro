---
import Container from './Container.astro';
import SystemLandscape from './SystemLandscape.astro';

const socials = [
	{ href: 'https://github.com/WiredMind2', label: 'GitHub' },
	{ href: 'https://linkedin.com/in/w-michaud', label: 'LinkedIn' },
	{ href: 'mailto:william@michaud.re', label: 'Email' },
];
---

<section
	id="top"
	class="relative border-b border-line pt-[var(--nav-height)]"
>
	<Container class="py-12 md:py-16 lg:py-20">
		<div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-10 xl:gap-16">
			<div data-hero-copy class="lg:col-span-6 xl:col-span-7">
				<p class="context-label">Software engineer · Lyon / Bethlehem</p>
				<h1
					class="mt-5 max-w-[12ch] font-display text-[clamp(3.35rem,7.5vw,7.75rem)] leading-[0.94] font-semibold tracking-[-0.065em]"
				>
					I build compilers, trading systems, and AI tooling.
				</h1>
				<p class="mt-7 max-w-2xl text-lg leading-relaxed text-muted md:text-xl">
					CTO at Buddimm and a computer science engineering student at INSA Lyon, currently on
					exchange at Lehigh University. Seeking a six-month internship from January 2027.
				</p>
				<div class="mt-8 flex flex-wrap items-center gap-5">
					<a href="#projects" class="button button-primary">
						Explore selected work <span aria-hidden="true">↓</span>
					</a>
					<a
						href="/Resume.pdf"
						target="_blank"
						rel="noopener noreferrer"
						class="text-link"
					>
						Open résumé <span class="link-mark" aria-hidden="true">↗</span>
					</a>
				</div>
			</div>
			<div class="lg:col-span-6 xl:col-span-5">
				<SystemLandscape />
			</div>
		</div>
	</Container>

	<div class="border-t border-line bg-paper">
		<Container class="flex flex-col gap-5 py-5 sm:flex-row sm:items-center sm:justify-between">
			<p class="text-sm font-medium">
				INSA Lyon ’27 <span class="mx-2 text-line">/</span> Lehigh University ’26
			</p>
			<ul class="flex flex-wrap gap-x-6 gap-y-2">
				{
					socials.map((social) => (
						<li>
							<a
								href={social.href}
								target={social.href.startsWith('mailto') ? undefined : '_blank'}
								rel="noopener noreferrer"
								class="text-link text-sm text-muted hover:text-ink"
							>
								{social.label} <span class="link-mark" aria-hidden="true">↗</span>
							</a>
						</li>
					))
				}
			</ul>
		</Container>
	</div>
</section>
