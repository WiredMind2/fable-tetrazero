---
import Container from './Container.astro';

const socials = [
	{ href: 'https://github.com/WiredMind2', label: 'GitHub', external: true },
	{ href: 'https://linkedin.com/in/w-michaud', label: 'LinkedIn', external: true },
	{ href: 'mailto:william@michaud.re', label: 'Email', external: false },
];
---

<section
	id="top"
	class="relative flex min-h-dvh flex-col overflow-hidden lg:grid lg:h-dvh lg:min-h-0 lg:grid-rows-[minmax(0,1fr)_auto]"
>
	<div class="grid-field absolute inset-0" aria-hidden="true"></div>
	<div
		class="pointer-events-none absolute -top-32 right-0 h-[26rem] w-[26rem] rounded-full bg-white/4 blur-[120px] md:h-[34rem] md:w-[34rem]"
		aria-hidden="true"
	>
	</div>

	<Container
		class="relative z-1 flex min-w-0 flex-1 flex-col justify-start pt-28 md:pt-32 lg:min-h-0 lg:justify-center lg:pt-16 lg:pb-4"
	>
		<!-- Ghost watermark + name stack -->
		<div class="relative flex min-w-0 flex-col items-start lg:items-center">
			<div class="relative w-fit max-w-full pt-20 md:pt-28 lg:pt-24">
				<p
					data-hero-fade
					class="hello-fade pointer-events-none absolute top-0 left-1/2 -translate-x-1/2 font-display text-[6rem] leading-none font-black italic whitespace-nowrap select-none md:text-[9.5rem]"
					style="--hello-stop: 24%"
					aria-hidden="true"
				>
					Hello.
				</p>

				<h1
					data-hero-fade
					class="hero-title relative font-display leading-[0.95] font-extrabold tracking-[0.02em] uppercase"
				>
					<span class="sr-only">William Michaud</span>
					<span
						aria-hidden="true"
						data-scramble
						data-scramble-text="WILLIAM MICHAUD"
						class="name-glow block"
					>
						WILLIAM MICHAUD
					</span>
				</h1>

				<p
					data-hero-fade
					class="relative mt-4 font-mono text-[0.7rem] font-medium tracking-[0.32em] text-ink/75 uppercase md:text-xs"
				>
					Systems · AI Tooling · Competitive Programming
				</p>
			</div>
		</div>

		<div data-hero-fade class="mt-10 max-w-xl md:mt-14 lg:mt-12">
			<p class="font-mono text-xs tracking-[0.14em] text-ink/80 uppercase sm:tracking-[0.18em]">
				INSA Lyon, class of 2027 · Lehigh exchange, Fall 2026
			</p>
			<p class="mt-4 text-base leading-relaxed text-muted md:text-lg">
				I build compilers, trading systems, and AI tooling, from agentic workflows to
				low-level engineering. CTO at Buddimm through January 2027. Seeking a 6-month
				internship starting January 2027.
			</p>
			<div class="mt-7 flex flex-wrap items-center gap-4">
				<a href="#projects" class="btn-solid">View work</a>
				<a href="#contact" class="btn-ghost">Get in touch</a>
			</div>

			<!-- Tablet/mobile: module inline below the text -->
			<div class="mt-12 flex justify-center lg:hidden">
				<div
					data-iso-zone
					data-cursor="highlight"
					class="iso w-[250px] md:w-[280px]"
					data-module="mark"
				>
				</div>
			</div>
		</div>
	</Container>

	<!-- Signature isometric mark, vertically centered on the right (lg+) -->
	<div
		class="pointer-events-none absolute inset-y-0 right-10 hidden w-[320px] items-center justify-center lg:flex xl:w-[360px]"
		aria-hidden="true"
	>
		<div
			data-iso-zone
			data-cursor="highlight"
			class="iso pointer-events-auto w-[280px] xl:w-[340px]"
			data-module="mark"
		>
		</div>
	</div>

	<Container class="relative shrink-0 border-t border-line pt-6 pb-24 md:pb-8">
		<div
			data-hero-fade
			class="flex flex-col items-start gap-6 sm:flex-row sm:flex-wrap sm:items-center sm:justify-between"
		>
			<div class="flex flex-wrap items-center gap-6">
				{
					socials.map((s) => (
						<a
							href={s.href}
							target={s.external ? '_blank' : undefined}
							rel={s.external ? 'noopener noreferrer' : undefined}
							class="font-mono text-xs tracking-[0.2em] text-muted uppercase transition-colors hover:text-ink"
						>
							{s.label} ↗
						</a>
					))
				}
			</div>
			<a
				href="#stats"
				class="flex items-center gap-3 font-mono text-xs tracking-[0.2em] text-muted uppercase transition-colors hover:text-ink"
			>
				Scroll to explore
				<span class="inline-block animate-bounce text-accent" aria-hidden="true">↓</span>
			</a>
		</div>
	</Container>
</section>
