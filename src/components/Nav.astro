---
import Container from './Container.astro';
import ThemeSwitch from './ThemeSwitch.astro';

const links = [
	{ href: '#about', label: 'Profile' },
	{ href: '#projects', label: 'Selected work' },
	{ href: '#experience', label: 'Experience' },
	{ href: '#skills', label: 'Toolkit' },
	{ href: '#contact', label: 'Contact' },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-line/80 bg-canvas/95 backdrop-blur-md">
	<Container class="flex h-[4.5rem] items-center justify-between">
		<a href="#top" class="shrink-0 text-sm font-semibold tracking-[-0.02em] text-ink no-underline">
			William <span class="text-blue">Michaud</span>
		</a>

		<div class="flex items-center gap-1.5">
			<div id="nav-links" class="hidden items-center gap-8 lg:flex">
				<nav aria-label="Primary navigation">
					<ul class="flex items-center gap-7">
						{
							links.map((link) => (
								<li>
									<a
										href={link.href}
										data-nav-link
										data-section={link.href.slice(1)}
										class="text-[0.82rem] font-medium"
									>
										{link.label}
									</a>
								</li>
							))
						}
					</ul>
				</nav>
				<a
					href="/Resume.pdf"
					target="_blank"
					rel="noopener noreferrer"
					class="button button-secondary min-h-0 px-3.5 py-2 text-[0.82rem]"
				>
					Résumé <span aria-hidden="true">↗</span>
				</a>
			</div>

			<ThemeSwitch />

			<button
				id="nav-toggle"
				type="button"
				class="flex min-h-12 min-w-12 items-center justify-end gap-2 text-sm font-medium lg:hidden"
				aria-label="Open menu"
				aria-expanded="false"
				aria-controls="nav-menu"
			>
				<span class="nav-toggle-label">Menu</span>
				<span class="relative block h-4 w-5" aria-hidden="true">
					<span class="nav-bar absolute top-1 left-0 block h-0.5 w-5 bg-ink transition-transform"></span>
					<span class="nav-bar absolute top-3 left-0 block h-0.5 w-5 bg-ink transition-transform"></span>
				</span>
			</button>
		</div>
	</Container>

	<div id="nav-menu" class="border-t border-line bg-canvas lg:hidden" hidden>
		<Container>
			<nav aria-label="Mobile navigation">
				<ul class="flex flex-col py-4">
					{
						links.map((link) => (
							<li class="border-b border-line/70 last:border-0">
								<a
									href={link.href}
									data-nav-link
									data-section={link.href.slice(1)}
									class="block py-3.5 text-lg font-medium"
								>
									{link.label}
								</a>
							</li>
						))
					}
					<li class="pt-4">
						<a
							href="/Resume.pdf"
							target="_blank"
							rel="noopener noreferrer"
							class="button button-primary w-full"
						>
							Open résumé <span aria-hidden="true">↗</span>
						</a>
					</li>
				</ul>
			</nav>
		</Container>
	</div>
</header>

<script>
	const toggle = document.getElementById('nav-toggle')!;
	const menu = document.getElementById('nav-menu')!;
	const toggleLabel = toggle.querySelector<HTMLElement>('.nav-toggle-label')!;
	const bars = toggle.querySelectorAll<HTMLElement>('.nav-bar');

	const setOpen = (open: boolean, returnFocus = false) => {
		menu.hidden = !open;
		toggle.setAttribute('aria-expanded', String(open));
		toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
		toggleLabel.textContent = open ? 'Close' : 'Menu';
		bars[0].style.transform = open ? 'translateY(4px) rotate(45deg)' : '';
		bars[1].style.transform = open ? 'translateY(-4px) rotate(-45deg)' : '';

		if (open) {
			menu.querySelector<HTMLAnchorElement>('a')?.focus();
		} else if (returnFocus) {
			toggle.focus();
		}
	};

	toggle.addEventListener('click', () => {
		setOpen(toggle.getAttribute('aria-expanded') !== 'true');
	});

	menu.querySelectorAll('a').forEach((a) =>
		a.addEventListener('click', () => {
			setOpen(false);
		})
	);

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
			setOpen(false, true);
		}
	});

	window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
		if (event.matches) setOpen(false);
	});
</script>
