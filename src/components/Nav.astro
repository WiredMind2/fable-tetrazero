---
const socials = [
	{ href: 'https://github.com/WiredMind2', label: 'GitHub', external: true },
	{ href: 'https://linkedin.com/in/w-michaud', label: 'LinkedIn', external: true },
	{ href: 'mailto:william@michaud.re', label: 'Email', external: false },
	{ href: '/Resume.pdf', label: 'Resume', external: true },
];

const links = [
	{ href: '#about', label: 'About' },
	{ href: '#projects', label: 'Work' },
	{ href: '#experience', label: 'Experience' },
	{ href: '#skills', label: 'Skills' },
	{ href: '#contact', label: 'Contact' },
];
---

<!-- Top: wordmark pill left, contact pill right (desktop), hamburger (mobile) -->
<header class="pointer-events-none fixed inset-x-0 top-0 z-50 flex items-start justify-between gap-4 p-4 md:p-6">
	<a
		href="#top"
		class="glass pointer-events-auto flex items-center rounded-pill px-4 py-2 font-mono text-xs font-semibold tracking-[0.22em] text-ink uppercase transition-colors hover:text-white"
		aria-label="Tetrazero — back to top"
	>
		tetra<span class="text-muted">zero</span>
	</a>

	<nav
		aria-label="Contact links"
		class="glass pointer-events-auto hidden items-center gap-1 rounded-pill p-1.5 md:flex"
	>
		{
			socials.map((s) => (
				<a
					href={s.href}
					target={s.external ? '_blank' : undefined}
					rel={s.external ? 'noopener noreferrer' : undefined}
					class="rounded-pill px-3.5 py-2 font-mono text-xs tracking-[0.14em] text-muted uppercase transition-colors hover:bg-white/5 hover:text-ink"
				>
					{s.label}
				</a>
			))
		}
	</nav>

	<button
		id="nav-toggle"
		class="glass pointer-events-auto flex h-10 w-10 flex-col items-center justify-center gap-1.5 rounded-pill md:hidden"
		aria-label="Toggle menu"
		aria-expanded="false"
		aria-controls="nav-menu"
	>
		<span class="nav-bar block h-px w-5 bg-ink transition-transform"></span>
		<span class="nav-bar block h-px w-5 bg-ink transition-opacity"></span>
		<span class="nav-bar block h-px w-5 bg-ink transition-transform"></span>
	</button>
</header>

<!-- Mobile sheet -->
<div id="nav-menu" class="glass fixed top-16 right-4 left-4 z-50 hidden rounded-2xl p-2 md:hidden">
	<ul class="flex flex-col">
		{
			links.map((link) => (
				<li>
					<a
						href={link.href}
						data-nav-link
						data-section={link.href.slice(1)}
						class="block rounded-xl px-4 py-3 font-mono text-sm tracking-[0.16em] uppercase"
					>
						{link.label}
					</a>
				</li>
			))
		}
		<li class="mt-1 border-t border-line pt-1">
			<ul class="flex flex-wrap gap-2 px-4 py-2">
				{
					socials.map((s) => (
						<li>
							<a
								href={s.href}
								target={s.external ? '_blank' : undefined}
								rel={s.external ? 'noopener noreferrer' : undefined}
								class="tag transition-colors hover:text-ink"
							>
								{s.label} ↗
							</a>
						</li>
					))
				}
			</ul>
		</li>
	</ul>
</div>

<!-- Bottom: floating section dock -->
<nav
	aria-label="Sections"
	class="pointer-events-none fixed inset-x-0 bottom-4 z-50 flex justify-center px-4 md:bottom-6"
>
	<ul class="glass pointer-events-auto flex max-w-full items-center gap-0.5 rounded-pill p-1.5 shadow-[0_16px_40px_-12px_#000000d9] md:gap-1">
		{
			links.map((link) => (
				<li>
					<a
						href={link.href}
						data-nav-link
						data-section={link.href.slice(1)}
						class="relative z-1 flex items-center rounded-pill px-2.5 py-2 font-mono text-[0.65rem] font-medium tracking-[0.08em] whitespace-nowrap uppercase md:px-3.5 md:text-[0.7rem] md:tracking-[0.1em]"
					>
						{link.label}
					</a>
				</li>
			))
		}
	</ul>
</nav>

<script>
	const toggle = document.getElementById('nav-toggle')!;
	const menu = document.getElementById('nav-menu')!;

	toggle.addEventListener('click', () => {
		const open = menu.classList.toggle('hidden') === false;
		toggle.setAttribute('aria-expanded', String(open));
	});

	menu.querySelectorAll('a').forEach((a) =>
		a.addEventListener('click', () => {
			menu.classList.add('hidden');
			toggle.setAttribute('aria-expanded', 'false');
		})
	);
</script>
