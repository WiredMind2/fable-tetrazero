---
import Container from './Container.astro';
import skills from '../data/skills.json';
---

<section id="skills" class="section-space border-y border-line bg-paper">
	<Container>
		<div class="grid gap-8 lg:grid-cols-12">
			<div class="lg:col-span-8">
				<p class="context-label">Toolkit</p>
				<h2 class="section-title mt-4">A broad toolkit, applied selectively.</h2>
			</div>
			<p class="section-intro self-end lg:col-span-4">
				Languages and platforms are means, not the portfolio. The project and experience sections
				show where each one earned its place.
			</p>
		</div>

		<div class="mt-16 grid gap-12 md:mt-20 lg:grid-cols-3 lg:gap-8">
			{
				skills.map((group) => (
					<section aria-labelledby={`skills-${group.group.toLowerCase().replaceAll(/[^a-z]+/g, '-')}`}>
						<h3
							id={`skills-${group.group.toLowerCase().replaceAll(/[^a-z]+/g, '-')}`}
							class="border-b border-ink pb-4 text-lg font-semibold tracking-[-0.02em]"
						>
							{group.group}
						</h3>
						<ul class="grid grid-cols-2 gap-x-5 sm:grid-cols-3 lg:grid-cols-2">
							{group.items.map((item) => (
								<li class="flex min-w-0 items-center gap-3 border-b border-line py-3.5">
									<img
										src={`/tech_icons/${item.icon}`}
										alt=""
										aria-hidden="true"
										width="20"
										height="20"
										loading="lazy"
										class="h-5 w-5 shrink-0 grayscale"
									/>
									<span class="truncate text-sm text-muted">{item.name}</span>
								</li>
							))}
						</ul>
					</section>
				))
			}
		</div>
	</Container>
</section>
