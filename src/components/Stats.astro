---
import Container from './Container.astro';

const stats = [
	{
		value: 2,
		prefix: '#',
		suffix: '',
		caption: 'Ranked 2nd in France, 40th / 53 - ICPC European Championship 2026, Warsaw',
	},
	{
		value: 500,
		prefix: '',
		suffix: 'K+',
		caption: 'Won 1st place against 500k+ participants, Castor Informatique (national high school CS contest)',
	},
	{
		value: 4,
		prefix: '',
		suffix: '×',
		caption: 'Prologin finalist - 2022, 2023, 2024, 2025',
	},
	{
		value: 33,
		prefix: '',
		suffix: '',
		caption: 'open-source projects shipped, and still many more to come...',
	},
];
---

<section id="stats" class="section-space border-b border-line bg-paper">
	<Container>
		<div class="grid gap-14 lg:grid-cols-12 lg:gap-10">
			<div class="lg:col-span-4">
				<p class="context-label">A few useful signals</p>
				<h2 class="mt-4 max-w-[9ch] text-4xl leading-[1.02] font-semibold tracking-[-0.045em] md:text-5xl">
					Evidence over adjectives.
				</h2>
			</div>

			<dl class="grid gap-x-10 sm:grid-cols-2 lg:col-span-8">
				{
					stats.map((stat) => (
						<div class="border-t border-line py-7 md:py-9">
							<dt class="text-[clamp(2.6rem,5vw,4.75rem)] leading-none font-semibold tracking-[-0.06em] text-blue"><span class="text-[0.7em]">{stat.prefix}</span>{stat.value}<span class="text-[0.7em]">{stat.suffix}</span></dt>
							<dd class="mt-4 max-w-[34ch] text-sm leading-relaxed text-muted md:text-base">
								{stat.caption}
							</dd>
						</div>
					))
				}
			</dl>
		</div>
	</Container>
</section>
