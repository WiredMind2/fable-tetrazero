---
import Container from './Container.astro';

const details = [
	{
		title: 'Competitive Programming',
		text: 'I compete regularly in computer science contests. My team ranked 2nd in France and 40th of 53 at the 2026 ICPC European Championship in Warsaw, and 3rd in France (18th of 142) at ICPC SWERC 2025. We will compete again at SWERC 2026.',
	},
	{
		title: 'Background',
		text: 'Computer science engineering student at INSA Lyon (Dipl\u00f4me d\u2019ing\u00e9nieur, GPA 3.9/4.0), graduating in June 2027, specializing in algorithms, machine learning, and agentic AI. This fall I am on exchange at Lehigh University in Bethlehem. Alongside my studies I lead student associations, including INSAlgo as president. At Buddimm I own the technical stack; recent work includes a security assessment at Profundum AI and an ST-to-C++ optimizer at BOBST.',
	},
	{
		title: 'Languages & Interests',
		text: 'I speak five languages: French (native), Creole (native), English (C2), German (B2) and Japanese (JLPT N4). Off the keyboard: mathematics, video games, the gym and running.',
	},
];
---

<section id="about" class="section-space bg-canvas">
	<Container>
		<div class="grid gap-16 lg:grid-cols-12 lg:gap-10">
			<div class="lg:col-span-5">
				<p class="context-label">Profile</p>
				<h2 class="section-title mt-4">Engineering across layers.</h2>
				<p class="mt-7 max-w-xl text-lg leading-relaxed text-muted">
					I write code for work, for sport, and for fun—from compilers and trading systems to
					three-player chess engines. My consulting work spans industrial optimization, AI
					adoption, and application security.
				</p>
				<p class="mt-5 max-w-xl leading-relaxed text-muted">
					When I am not shipping open-source projects, I am solving algorithm problems or
					designing contest exercises for others.
				</p>
				<a
					href="/Resume.pdf"
					target="_blank"
					rel="noopener noreferrer"
					class="text-link mt-7"
				>
					Read the one-page résumé <span class="link-mark" aria-hidden="true">↗</span>
				</a>
			</div>

			<div class="lg:col-span-7 lg:pt-8">
				{
					details.map((detail) => (
						<article class="grid gap-4 border-t border-line py-7 sm:grid-cols-12 sm:gap-8 md:py-9">
							<h3 class="text-lg leading-tight font-semibold tracking-[-0.02em] sm:col-span-4">
								{detail.title}
							</h3>
							<p class="leading-relaxed text-muted sm:col-span-8">{detail.text}</p>
						</article>
					))
				}
			</div>
		</div>
	</Container>
</section>
