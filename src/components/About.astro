---
import Container from './Container.astro';
import SectionHeader from './SectionHeader.astro';

const tracks = [
	{
		num: '01',
		title: 'Freelance',
		chip: '2026 · Citeos · BOBST',
		module: 'shelf',
		intro: 'I take on real engineering problems end to end — industrial toolchains, satellite-imagery AI, security audits.',
		steps: [
			'Citeos (VINCI Energies): satellite-imagery AI that cuts streetlight audits from a month of field work to a few hours.',
			'BOBST: reimplemented a 25,000-line Structured Text optimizer in C++, building my own ST compiler to do it.',
			'Profundum AI: full security audit of a live AI SaaS platform, from the subscription system to the LLM pipeline.',
		],
	},
	{
		num: '02',
		title: 'AI Tooling',
		chip: 'Agents · daily driver',
		module: 'agents',
		intro: 'AI is how I work and what I ship: agentic workflows running in production, not just prototypes.',
		steps: [
			'As CTO at Buddimm, rolled out Claude for Teams and company-wide MCP servers.',
			'Grew Buddimm’s traffic from ~200 to ~2,000 visits in two weeks with an AI-driven SEO workflow.',
			'Satellite-imagery pipeline at Citeos (VINCI): streetlight audits cut from a month of field work to hours.',
		],
	},
	{
		num: '03',
		title: 'Competitive Programming',
		chip: 'ICPC · Prologin',
		module: 'board',
		intro: 'Algorithms as a sport: I train, I compete, and I set problems for others to solve.',
		steps: [
			'2nd in France, 40th of 53 at the ICPC European Championship 2026, Warsaw.',
			'3rd in France at SWERC 2025 — qualified again for SWERC 2026 this December.',
			'Four-time Prologin finalist; 1st of 2,000+ at Match’Up 2022, then problem-setter for two editions.',
		],
	},
];
---

<section id="about" class="relative overflow-hidden py-24 md:py-32">
	<Container>
		<SectionHeader index="01" label="Practice" title="What I do" />

		<p data-reveal class="mb-12 max-w-2xl text-lg leading-relaxed text-muted md:mb-16 md:text-xl">
			Hey there, I'm William — I write code for work, for sport, and for fun. Three
			things I keep coming back to:
		</p>

		<div class="grid min-w-0 gap-5 md:grid-cols-3">
			{
				tracks.map((track) => (
					<article
						data-reveal
						data-iso-zone
						data-cursor="highlight"
						class="card card-lift relative flex flex-col p-6 md:p-7"
					>
						<span
							class="ghost-index pointer-events-none absolute top-3 right-4 text-[3.4rem] md:text-[4rem]"
							aria-hidden="true"
						>
							{track.num}
						</span>

						<h3 class="relative min-w-0 pr-16 font-display text-2xl font-semibold tracking-[-0.03em] text-balance md:pr-14">
							{track.title}
						</h3>
						<p class="tag mt-3 w-fit">{track.chip}</p>

						<div class="iso my-2 mx-auto w-full max-w-[280px]" data-module={track.module} />

						<p class="relative leading-relaxed text-muted">{track.intro}</p>

						<ul class="mt-4 grid gap-2.5 border-t border-line pt-4 text-sm leading-relaxed text-ink/80">
							{track.steps.map((step) => (
								<li class="flex items-start gap-3">
									<span class="mt-[0.45rem] h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
									<span>{step}</span>
								</li>
							))}
						</ul>
					</article>
				))
			}
		</div>

	</Container>
</section>
