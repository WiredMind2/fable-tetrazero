---
import { getCollection } from 'astro:content';
import Container from './Container.astro';

const idOrder = [
	'buddimm',
	'bobst',
	'profundum-security',
	'competitions',
	'vr-research',
	'npu-carbon-fiber',
	'lehigh',
	'insa-lyon',
	'leadership',
];

const groupLabel = {
	work: 'Professional',
	competition: 'Competition',
	research: 'Research',
	leadership: 'Leadership',
	education: 'Education',
} as const;

const experiences = (await getCollection('experiences'))
	.map((entry) => entry.data)
	.sort((a, b) => {
		const rank = (id: string) => {
			const i = idOrder.indexOf(id);
			return i === -1 ? idOrder.length : i;
		};
		return rank(a.id) - rank(b.id);
	});
---

<section id="experience" class="section-space bg-canvas">
	<Container>
		<div class="grid gap-16 lg:grid-cols-12 lg:gap-12">
			<div class="lg:col-span-4">
				<div class="lg:sticky lg:top-28">
					<p class="context-label">Experience</p>
					<h2 class="section-title mt-4">Work across systems and contexts.</h2>
					<p class="section-intro mt-7">
						Industry, research, competition, education, and leadership—presented as one record
						instead of separate personas.
					</p>
				</div>
			</div>

			<ol class="lg:col-span-8">
				{
					experiences.map((exp) => (
						<li class="border-t border-line py-9 first:pt-0 md:py-12">
							<article>
								<div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
									<span class="font-semibold text-blue">{exp.period}</span>
									<span class="text-muted">{groupLabel[exp.group]}</span>
								</div>

								<h3 class="mt-4 max-w-3xl text-2xl leading-tight font-semibold tracking-[-0.035em] md:text-3xl">
									{exp.title}
								</h3>
								<p class="mt-1.5 font-medium text-muted">{exp.org}</p>
								<p class="mt-5 max-w-3xl leading-relaxed text-muted">{exp.description}</p>

								{exp.achievements.length > 0 && (
									<ul class="mt-6 grid gap-3">
										{exp.achievements.map((achievement) => (
											<li class="flex max-w-3xl items-start gap-3 leading-relaxed">
												<span class="mt-[0.72em] h-1.5 w-1.5 shrink-0 rounded-full bg-orange" aria-hidden="true" />
												<span>{achievement}</span>
											</li>
										))}
									</ul>
								)}

								{exp.technologies.length > 0 && (
									<ul class="tag-list mt-7" aria-label={`${exp.title} skills`}>
										{exp.technologies.map((tech) => <li>{tech}</li>)}
									</ul>
								)}
							</article>
						</li>
					))
				}
			</ol>
		</div>
	</Container>
</section>
