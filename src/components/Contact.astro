---
import Container from './Container.astro';

const details = [
	{ label: 'Availability', value: '6-month internship starting January 2027' },
];

const socials = [
	{ href: 'https://github.com/WiredMind2', label: 'GitHub' },
	{ href: 'https://linkedin.com/in/w-michaud', label: 'LinkedIn' },
	{ href: 'mailto:william@michaud.re', label: 'Email' },
];
---

<section id="contact" class="section-space bg-night text-white">
	<Container>
		<div class="grid gap-16 lg:grid-cols-12 lg:gap-14">
			<div class="lg:col-span-5">
				<p class="text-sm font-semibold text-[#8eb0ff]">Contact</p>
				<h2 class="mt-4 max-w-[10ch] text-[clamp(2.75rem,6vw,5.75rem)] leading-[0.98] font-semibold tracking-[-0.055em]">
					Let’s build something that has to work.
				</h2>
				<p class="mt-7 max-w-xl text-lg leading-relaxed text-white/60">
					Whether you have an internship opening, an engineering problem, or a question about
					the work, send the details below.
				</p>

				<dl class="mt-10 border-t border-white/20">
					{
						details.map((detail) => (
							<div class="border-b border-white/20 py-5">
								<dt class="text-sm text-white/50">{detail.label}</dt>
								<dd class="mt-1 font-medium text-white">{detail.value}</dd>
							</div>
						))
					}
				</dl>

				<ul class="mt-8 flex flex-wrap gap-x-6 gap-y-3">
					{
						socials.map((social) => (
							<li>
								<a
									href={social.href}
									target={social.href.startsWith('mailto') ? undefined : '_blank'}
									rel="noopener noreferrer"
									class="text-link text-sm text-white/60 hover:text-white"
								>
									{social.label} <span class="link-mark" aria-hidden="true">↗</span>
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<form
				id="contact-form"
				class="relative space-y-5 lg:col-span-7"
				action="/api/contact"
				method="post"
				novalidate
			>
				<div class="grid gap-5 sm:grid-cols-2">
					<div class="field-group">
						<label for="cf-name" class="field-label">Name <span aria-hidden="true">*</span></label>
						<input
							id="cf-name"
							name="name"
							type="text"
							class="field"
							placeholder="Your name"
							autocomplete="name"
							maxlength="100"
							aria-describedby="cf-name-error"
							required
						/>
						<p id="cf-name-error" class="error-msg hidden" data-for="name"></p>
					</div>
					<div class="field-group">
						<label for="cf-email" class="field-label">Email <span aria-hidden="true">*</span></label>
						<input
							id="cf-email"
							name="email"
							type="email"
							class="field"
							placeholder="your.email@example.com"
							autocomplete="email"
							inputmode="email"
							autocapitalize="none"
							autocorrect="off"
							spellcheck="false"
							maxlength="254"
							aria-describedby="cf-email-error"
							required
						/>
						<p id="cf-email-error" class="error-msg hidden" data-for="email"></p>
					</div>
				</div>
				<div class="field-group">
					<label for="cf-subject" class="field-label">Subject <span aria-hidden="true">*</span></label>
					<input
						id="cf-subject"
						name="subject"
						type="text"
						class="field"
						placeholder="What's this about?"
						maxlength="200"
						aria-describedby="cf-subject-error"
						required
					/>
					<p id="cf-subject-error" class="error-msg hidden" data-for="subject"></p>
				</div>
				<div class="field-group">
					<label for="cf-message" class="field-label">Message <span aria-hidden="true">*</span></label>
					<textarea
						id="cf-message"
						name="message"
						rows="7"
						class="field resize-y"
						placeholder="Tell me what you are working on."
						minlength="10"
						maxlength="5000"
						aria-describedby="cf-message-error"
						required></textarea>
					<p id="cf-message-error" class="error-msg hidden" data-for="message"></p>
				</div>

				<div class="absolute -left-[9999px] h-0 w-0 overflow-hidden" aria-hidden="true">
					<label for="cf-website">Website</label>
					<input
						id="cf-website"
						name="website"
						type="text"
						tabindex="-1"
						autocomplete="off"
						value=""
					/>
				</div>

				<div class="flex flex-wrap items-center gap-5 pt-1">
					<button
						type="submit"
						class="button button-light cursor-pointer disabled:cursor-wait disabled:opacity-60"
					>
						Send message
					</button>
					<p
						id="form-status"
						class="hidden text-sm font-medium"
						role="status"
						aria-live="polite"
					>
					</p>
				</div>
			</form>
		</div>
	</Container>
</section>

<script>
	const form = document.getElementById('contact-form') as HTMLFormElement;
	const status = document.getElementById('form-status')!;
	const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
	const fieldNames = ['name', 'email', 'subject', 'message'] as const;

	const setError = (name: string, message: string) => {
		const input = form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement;
		const msg = form.querySelector<HTMLParagraphElement>(`.error-msg[data-for="${name}"]`)!;
		input.classList.toggle('error', !!message);
		input.setAttribute('aria-invalid', String(!!message));
		msg.textContent = message;
		msg.classList.toggle('hidden', !message);
	};

	const validateField = (name: (typeof fieldNames)[number], value: string) => {
		const trimmed = value.trim();
		if (!trimmed) return `${name[0].toUpperCase()}${name.slice(1)} is required`;
		if (name === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(trimmed)) {
			return 'Enter a valid email address';
		}
		if (name === 'message' && trimmed.length < 10) {
			return 'Message must be at least 10 characters';
		}
		return '';
	};

	const validate = (data: Record<string, string>) => {
		let ok = true;
		for (const name of fieldNames) {
			const message = validateField(name, data[name] ?? '');
			setError(name, message);
			if (message) ok = false;
		}
		return ok;
	};

	const showStatus = (kind: 'success' | 'error', text: string) => {
		status.textContent = text;
		status.dataset.kind = kind;
		status.classList.remove('hidden');
		setTimeout(() => status.classList.add('hidden'), 6000);
	};

	for (const name of fieldNames) {
		const input = form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement;
		input.addEventListener('input', () => {
			if (input.getAttribute('aria-invalid') === 'true') setError(name, '');
		});
		input.addEventListener('blur', () => {
			setError(name, validateField(name, input.value));
		});
	}

	form.addEventListener('submit', async (e) => {
		e.preventDefault();

		const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
		if (!validate(data)) {
			form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
			return;
		}

		submitBtn.disabled = true;
		submitBtn.textContent = 'Sending…';

		try {
			const response = await fetch('/api/contact', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({
					name: data.name,
					email: data.email,
					subject: data.subject,
					message: data.message,
					website: data.website ?? '',
				}),
			});

			const result = (await response.json().catch(() => null)) as { ok?: boolean; error?: string } | null;
			if (!response.ok || !result?.ok) {
				throw new Error(result?.error || `Failed to send: ${response.status}`);
			}

			form.reset();
			for (const name of fieldNames) setError(name, '');
			showStatus('success', 'Message sent. Thank you.');
		} catch (error) {
			console.error('Form submission error:', error);
			showStatus('error', 'Something went wrong. Try again or email me directly.');
		} finally {
			submitBtn.disabled = false;
			submitBtn.textContent = 'Send message';
		}
	});
</script>
