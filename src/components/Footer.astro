---
import Container from './Container.astro';

const year = new Date().getFullYear();
---

<footer class="border-t border-line">
	<Container
		class="flex flex-col items-start justify-between gap-6 py-10 pb-36 md:flex-row md:items-center md:pb-32"
	>
		<div class="font-mono text-xs tracking-[0.2em] text-muted uppercase">
			© {year} William Michaud — Tetrazero
		</div>

		<div class="flex items-center gap-6 font-mono text-xs tracking-[0.15em] uppercase">
			<a href="/privacy/" class="text-muted transition-colors hover:text-ink">Privacy</a>
			<a href="/terms/" class="text-muted transition-colors hover:text-ink">Terms</a>
		</div>
	</Container>
</footer>
