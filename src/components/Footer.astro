---
import Container from './Container.astro';

const year = new Date().getFullYear();
---

<footer class="bg-paper">
	<Container
		class="flex flex-col items-start justify-between gap-6 py-9 sm:flex-row sm:items-center"
	>
		<p class="text-sm text-muted">&copy; {year} William Michaud · Tetrazero</p>

		<nav aria-label="Legal">
			<ul class="flex items-center gap-6 text-sm">
				<li><a href="/privacy/" class="text-muted hover:text-ink">Privacy</a></li>
				<li><a href="/terms/" class="text-muted hover:text-ink">Terms</a></li>
			</ul>
		</nav>
	</Container>
</footer>
