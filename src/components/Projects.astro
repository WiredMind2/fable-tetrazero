---
import { getCollection } from 'astro:content';
import Container from './Container.astro';
import SectionHeader from './SectionHeader.astro';

const all = (await getCollection('projects')).map((entry) => entry.data);

const featuredOrder = ['C-Compiler', 'OpenTrade', 'AnimeManager'];
const featured = all
	.filter((p) => p.featured)
	.sort((a, b) => {
		const rank = (p: (typeof all)[number]) => {
			const i = featuredOrder.indexOf(p.title);
			return i === -1 ? featuredOrder.length : i;
		};
		return rank(a) - rank(b);
	});

const categoryLabel: Record<string, string> = {
	web: 'Web',
	fullstack: 'Full-stack',
	other: 'Systems',
};

// Each featured project gets its own isometric mark
const moduleByTitle: Record<string, string> = {
	'C-Compiler': 'pipeline',
	OpenTrade: 'chart',
	AnimeManager: 'shelf',
};
---

<section id="projects" class="relative overflow-hidden py-24 md:py-32">
	<Container>
		<SectionHeader index="02" label="Selected Work" title="Projects" />

		<div class="grid min-w-0 gap-5 md:grid-cols-2">
			{
				featured.map((project, i) => (
					<a
						data-reveal
						href={project.githubUrl}
						target="_blank"
						rel="noopener noreferrer"
						data-iso-zone
						data-cursor="highlight"
						class:list={[
							'card card-lift group relative flex min-w-0 flex-col overflow-hidden p-6 md:p-8',
							i === 0 && 'md:col-span-2',
						]}
					>
						<span
							class="ghost-index pointer-events-none absolute right-4 -bottom-6 text-[4.5rem] transition-colors group-hover:[-webkit-text-stroke-color:#ffffff38] md:text-[8rem]"
							aria-hidden="true"
						>
							0{i + 1}
						</span>

						<div class="relative flex flex-1 flex-col gap-6 md:flex-row md:items-center">
							<div class="min-w-0 flex-1">
								<div class="flex items-start justify-between gap-4">
									<p class="kicker">Featured · {categoryLabel[project.category]}</p>
									<span
										class="font-mono text-lg text-muted transition-all group-hover:translate-x-1 group-hover:-translate-y-1 group-hover:text-ink"
										aria-hidden="true"
									>
										↗
									</span>
								</div>
								<h3 class="mt-4 font-display text-2xl font-semibold tracking-[-0.03em] text-balance md:text-3xl">
									{project.title}
								</h3>
								<p class="mt-4 max-w-xl leading-relaxed text-muted">
									{project.longDescription}
								</p>
							</div>

							<div
								class="iso w-[210px] shrink-0 self-center max-md:mx-auto md:w-[230px]"
								data-module={moduleByTitle[project.title] ?? 'stack'}
							/>
						</div>

						<div class="relative mt-6 flex flex-wrap gap-2 border-t border-line pt-5">
							<span class="tag tag--status">Open Source</span>
							{project.techStack.map((tech) => (
								<span class="tag">{tech}</span>
							))}
						</div>
					</a>
				))
			}
		</div>

		<div data-reveal class="mt-12 flex flex-col items-center gap-5 md:mt-16">
			<p class="font-mono text-xs tracking-[0.2em] text-muted uppercase">
				And many more side projects
			</p>
			<a
				href="https://github.com/WiredMind2?tab=repositories"
				target="_blank"
				rel="noopener noreferrer"
				class="btn-solid"
			>
				View all on GitHub ↗
			</a>
		</div>
	</Container>
</section>
