---
import { getCollection } from 'astro:content';
import Container from './Container.astro';
import ProjectVisual from './ProjectVisual.astro';

const all = (await getCollection('projects')).map((entry) => entry.data);

const featuredOrder = ['C-Compiler', 'OpenTrade', 'Chess2'];
const featured = all
	.filter((p) => p.featured)
	.sort((a, b) => {
		const rank = (p: (typeof all)[number]) => {
			const i = featuredOrder.indexOf(p.title);
			return i === -1 ? featuredOrder.length : i;
		};
		return rank(a) - rank(b);
	});
---

<section id="projects" class="section-space border-y border-line bg-paper">
	<Container>
		<div class="grid gap-8 lg:grid-cols-12">
			<div class="lg:col-span-8">
				<p class="context-label">Selected work</p>
				<h2 class="section-title mt-4">Three systems, three different constraints.</h2>
			</div>
			<p class="section-intro self-end lg:col-span-4">
				Each project started with a different hard problem: translating a language, testing a
				market hypothesis, or teaching a chess engine new geometry.
			</p>
		</div>

		<div class="mt-20 space-y-28 md:mt-28 md:space-y-36">
			{
				featured.map((project, i) => (
					<article class="grid items-center gap-10 lg:grid-cols-12 lg:gap-14 xl:gap-20">
						<div
							class:list={[
								'lg:col-span-5',
								i % 2 === 1 && 'lg:col-start-8 lg:row-start-1',
							]}
						>
							<p class="context-label">Selected project {i + 1} of {featured.length}</p>
							<h3 class="mt-4 text-[clamp(2.25rem,5vw,4.75rem)] leading-none font-semibold tracking-[-0.055em]">
								{project.title}
							</h3>
							<p class="mt-6 text-lg leading-relaxed text-muted">{project.description}</p>
							<ul class="tag-list mt-7" aria-label={`${project.title} technologies`}>
								{project.techStack.map((tech) => <li>{tech}</li>)}
							</ul>
							<a
								href={project.githubUrl}
								target="_blank"
								rel="noopener noreferrer"
								class="text-link mt-8"
							>
								Inspect the repository <span class="link-mark" aria-hidden="true">↗</span>
							</a>
						</div>

						<div
							class:list={[
								'lg:col-span-7',
								i % 2 === 1 && 'lg:col-start-1 lg:row-start-1',
							]}
						>
							<ProjectVisual title={project.title} />
						</div>
					</article>
				))
			}
		</div>

		<div class="mt-24 flex flex-col gap-5 border-t border-line pt-8 sm:flex-row sm:items-center sm:justify-between md:mt-32">
			<p class="max-w-xl text-muted">
				These are three of 33 open-source projects spanning systems, web applications, machine
				learning, and developer tools.
			</p>
			<a
				href="https://github.com/WiredMind2?tab=repositories"
				target="_blank"
				rel="noopener noreferrer"
				class="button button-secondary shrink-0"
			>
				View all on GitHub <span aria-hidden="true">↗</span>
			</a>
		</div>
	</Container>
</section>
